---
whiskers:
  version: ^2.0.0
  filename: "plugin/palettes.lua"
---
{%- set order = ['winter', 'fall', 'spring', 'summer'] -%}
{%- set accents = ['red', 'orange', 'yellow', 'lime', 'green', 'aqua', 'skye', 'snow', 'blue', 'purple', 'pink', 'cherry'] -%}
{%- set neutrals = ['text', 'subtext1', 'subtext0', 'overlay2', 'overlay1', 'overlay0', 'surface2', 'surface1', 'surface0', 'base', 'mantle', 'crust'] -%}
-- This file is generated from wezterm.tera by Whiskers. Do not edit by hand.
--
-- It is the palette data the plugin turns into WezTerm color schemes; run
-- `just build` after the evergarden palette changes.
return {
  -- Flavors in cycle order.
  order = { {% for id in order %}'{{id}}'{% if not loop.last %}, {% endif %}{% endfor %} },

  -- Accent colors in cycle order. Every flavor defines all of these.
  accents = { {% for accent in accents %}'{{accent}}'{% if not loop.last %}, {% endif %}{% endfor %} },

  flavors = {
{%- for id in order %}
{%- set flavor = flavors[id] %}
    {{id}} = {
      name = '{{flavor.name}}',
      dark = {{flavor.dark}},
      colors = {
{%- for accent in accents %}
        {{accent}} = '#{{flavor.colors[accent].hex}}',
{%- endfor %}
{%- for neutral in neutrals %}
        {{neutral}} = '#{{flavor.colors[neutral].hex}}',
{%- endfor %}
      },
    },
{%- endfor %}
  },
}
